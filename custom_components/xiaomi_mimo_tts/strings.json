{
  "config": {
    "step": {
      "user": {
        "title": "Xiaomi MiMo TTS",
        "description": "Enter your Xiaomi MiMo API key from platform.xiaomimimo.com.",
        "data": {
          "api_key": "API key",
          "name": "Display name (optional)"
        },
        "data_description": {
          "name": "Used to distinguish multiple Xiaomi MiMo accounts. Defaults to \"Xiaomi MiMo TTS\" if left blank."
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate Xiaomi MiMo TTS",
        "description": "Your Xiaomi MiMo API key was rejected. Enter a new key.",
        "data": {
          "api_key": "API key"
        }
      },
      "reconfigure": {
        "title": "Reconfigure Xiaomi MiMo TTS",
        "data": {
          "name": "Display name",
          "base_url": "Base URL",
          "request_timeout": "Request timeout (seconds)"
        },
        "data_description": {
          "name": "Rename this account. Leave unchanged to keep the current name."
        }
      }
    },
    "error": {
      "invalid_api_key": "Invalid API key.",
      "cannot_connect": "Cannot connect to Xiaomi MiMo API.",
      "unknown": "Unknown error. Check the log."
    },
    "abort": {
      "already_configured": "This API key is already configured.",
      "reauth_successful": "Re-authentication was successful.",
      "reconfigure_successful": "Configuration updated."
    }
  },
  "config_subentries": {
    "built_in": {
      "entry_type": "Built-in voice",
      "initiate_flow": {
        "user": "Add built-in voice"
      },
      "step": {
        "user": {
          "title": "Built-in voice",
          "data": {
            "name": "Profile name",
            "voice": "Voice",
            "default_style_prompt": "Default style prompt (optional)"
          }
        },
        "reconfigure": {
          "title": "Reconfigure built-in voice",
          "data": {
            "name": "Profile name",
            "voice": "Voice",
            "default_style_prompt": "Default style prompt (optional)"
          }
        }
      },
      "abort": {
        "reconfigure_successful": "Voice profile updated."
      }
    },
    "voice_design": {
      "entry_type": "Designed voice",
      "initiate_flow": {
        "user": "Add designed voice"
      },
      "step": {
        "user": {
          "title": "Voice design",
          "description": "Describe the voice in natural language; Xiaomi MiMo will synthesize it.",
          "data": {
            "name": "Profile name",
            "voice_description": "Voice description"
          }
        },
        "reconfigure": {
          "title": "Reconfigure designed voice",
          "data": {
            "name": "Profile name",
            "voice_description": "Voice description"
          }
        }
      },
      "abort": {
        "reconfigure_successful": "Voice profile updated."
      }
    },
    "voice_clone": {
      "entry_type": "Cloned voice",
      "initiate_flow": {
        "user": "Add cloned voice"
      },
      "step": {
        "user": {
          "title": "Voice clone",
          "description": "Provide an audio sample to clone.",
          "data": {
            "name": "Profile name",
            "sample_source": "Sample source"
          }
        },
        "upload": {
          "title": "Upload audio sample",
          "description": "Optionally name the file. Leave blank for an auto-generated clone_xxxx name.",
          "data": {
            "audio_file": "Audio file (mp3 or wav, max 10 MB)",
            "save_as": "Save as (optional, e.g. alice)"
          }
        },
        "pick": {
          "title": "Pick existing sample",
          "data": {
            "voice_sample_id": "Sample"
          }
        },
        "reconfigure": {
          "title": "Reconfigure cloned voice",
          "data": {
            "name": "Profile name",
            "sample_source": "Sample source"
          }
        }
      },
      "abort": {
        "no_samples_found": "No voice samples found in /media/voice_samples.",
        "reconfigure_successful": "Voice profile updated."
      },
      "error": {
        "invalid_sample": "Invalid audio sample."
      }
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Xiaomi MiMo TTS options",
        "data": {
          "request_timeout": "Request timeout (seconds)",
          "streaming_enabled": "Enable streaming",
          "voice_samples_dir": "Voice samples directory",
          "default_audio_format": "Default audio format"
        }
      }
    }
  },
