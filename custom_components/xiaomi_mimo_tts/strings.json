  "issues": {
    "voice_sample_missing": {
      "title": "Voice sample missing",
      "fix_flow": {
        "step": {
          "init": {
            "title": "Restore voice sample for {profile_name}",
            "description": "The sample at {missing_path} could not be found. Pick a new one or upload."
          }
        }
      }
    },
    "model_unavailable": {
      "title": "Model unavailable for {profile_name}",
      "description": "Your Xiaomi MiMo account cannot access {model_id}. Visit platform.xiaomimimo.com to enable beta access."
    },
    "quota_exceeded": {
      "title": "Xiaomi MiMo quota exceeded",
      "description": "Top up at platform.xiaomimimo.com."
    },
    "media_dir_unwritable": {
      "title": "Voice samples directory unwritable",
      "description": "Cannot write to {dir_path}. Adjust the option or fix permissions."
